# Application
NODE_ENV=development
PORT=3000
APP_NAME="NestJS Secure"
APP_VERSION=1.0.0

# CORS (comma-separated origins, empty = all blocked)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=info

# Rate Limiting (requests per TTL window)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/nest_secure?schema=public

# JWT — must be at least 32 characters each
JWT_SECRET=replace-with-a-secure-random-secret-minimum-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace-with-another-secure-random-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=30d
